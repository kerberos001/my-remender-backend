# my-reminders-backend/.env
PORT=8080

# Configuración de Postgres (Coincide con Docker Compose)
DB_HOST=localhost
DB_PORT=5432
DB_USER=myuser
DB_PASSWORD=mypassword
DB_NAME=reminders_db
DB_SSLMODE=disable # disable para local

# Clave secreta para firmar los JWT (HS256)
# ¡Genera una cadena aleatoria y compleja!
JWT_SECRET=supersecretolocalnoparasupabase